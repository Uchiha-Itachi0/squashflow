{
  "name": "squashflow-monorepo",
  "private": true,
  "description": "Squashflow: pin a comment on any website and your own Claude Code session fixes it.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:shared": "pnpm --filter @squashflow/shared run build",
    "typecheck": "pnpm build:shared && pnpm -r run typecheck",
    "test": "pnpm build:shared && pnpm -r run test",
    "test:e2e": "pnpm --filter @squashflow/extension run test:e2e",
    "lint": "pnpm build:shared && eslint . && prettier --check .",
    "format": "prettier --write .",
    "package": "pnpm --filter @squashflow/extension run package",
    "check:pack": "node scripts/check-helper-pack.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
