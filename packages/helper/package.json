{
  "name": "squashflow",
  "version": "0.1.0",
  "description": "Local helper for Squashflow: delivers browser pins into your running Claude Code session.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "squashflow": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --external:zod --outfile=dist/cli.js --log-level=warning",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@squashflow/shared": "workspace:*",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "vitest": "5.0.5"
  }
}
