{
  "name": "@squashflow/extension",
  "version": "0.1.0",
  "private": true,
  "displayName": "Squashflow",
  "description": "Pin comments on any page and send them, with page context, to your Claude Code session.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package": "plasmo build && node scripts/package.mjs",
    "store:screenshots": "playwright test -c playwright.store.config.ts",
    "icons": "node scripts/render-icons.ts"
  },
  "dependencies": {
    "@squashflow/shared": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.7",
    "@types/node": "24.19.2",
    "jsdom": "30.1.3",
    "plasmo": "0.90.5",
    "vitest": "5.0.5"
  },
  "manifest": {
    "permissions": [
      "activeTab",
      "scripting",
      "storage",
      "unlimitedStorage"
    ],
    "action": {
      "default_title": "Squashflow: toggle pin mode"
    },
    "commands": {
      "_execute_action": {
        "suggested_key": {
          "default": "Alt+Shift+P"
        },
        "description": "Toggle pin mode on the current page"
      }
    }
  }
}
